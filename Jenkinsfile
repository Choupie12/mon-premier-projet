pipeline {

    agent any

    stages {

        stage('Checkout') {
            steps {
                echo 'Recuperation du code source'
            }
        }

        stage('Build') {
            steps {
                echo 'Construction de l application'
            }
        }

        stage('Test') {
            steps {
                echo 'Execution des tests'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploiement de l application'
            }
        }
    }
}
